<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Everything the app fetches from the internet is HTTPS, and stays that
         way. The one exception is the in-process style server on 127.0.0.1:
         MapLibre's offline downloader will not read a style from an asset or a
         file, so the pruned satellite and hybrid styles are handed to it over a
         loopback socket that never leaves the device. See
         app/lib/offline/style_server_io.dart. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
