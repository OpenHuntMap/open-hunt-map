# Flutter / Dart
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/Generated.xcconfig
**/flutter_export_environment.sh

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# GIS tooling venv / caches
tools/gis/.venv/
tools/gis/__pycache__/
tools/gis/_tmp*/
tools/gis/_tmp*.zip
# Scratch output from one-off source probes (name lists, comparison renders)
tools/gis/_*.txt
tools/gis/_*.png
*.pyc

# Generated by scripts/sync_assets.*; data/ is the source of truth
app/assets/data/*
!app/assets/data/README.md
!app/assets/data/.gitkeep

# Province packs are release artifacts, not repo content
packs/

# Large regenerated overlays. A minified 30 MB GeoJSON has no reviewable diff,
# and every rebuild would add another full copy to history. Rebuild them with
# tools/gis/rebuild_geometry.py; consume them from the published pack.
# Small layers stay tracked: scrape_seasons_on.py reads wmu.geojson without
# running the geometry fetchers.
data/on/overlays/crown_land.geojson
data/on/overlays/crown_land.clupa_full.geojson
data/on/overlays/crown_disposition.geojson
data/on/overlays/municipalities.geojson
data/qc/overlays/municipalities.geojson

# Generated place-name indexes. Same reasoning: 2 MB of Ontario and 5 MB of
# Quebec minified JSON has no reviewable diff. Rebuild them with
# tools/gis/fetch_cgndb.py; consume them from the published pack.
data/on/gazetteer/places.json
data/qc/gazetteer/places.json

# Local large packs (keep samples only in git)
*.pmtiles
!app/assets/**/*.pmtiles

# Secrets (none expected; belt and suspenders)
.env
.env.*

# Screenshots and logcat from tools/devtest. Evidence from a test run, not
# repo content: regenerate them rather than commit them.
.artifacts/
